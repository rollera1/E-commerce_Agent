# Development database. MySQL runs on the Ubuntu server at 127.0.0.1:3308.
# scripts/start-database.cmd forwards it to this computer at 127.0.0.1:3307.
MYSQL_ROOT_PASSWORD=local_root_password
MYSQL_DATABASE=ecommerce_agent
MYSQL_USER=ecommerce_agent
MYSQL_PASSWORD=local_dev_password
DB_URL=jdbc:mysql://localhost:3307/ecommerce_agent?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=ecommerce_agent
DB_PASSWORD=local_dev_password

# Python Agent runtime database. PostgreSQL runs on the server at 127.0.0.1:5434
# and scripts/start-database.cmd forwards it locally to 127.0.0.1:5433.
POSTGRES_DB=agent_runtime
POSTGRES_USER=agent_runtime
POSTGRES_PASSWORD=local_agent_password
AGENT_DATABASE_URL=postgresql+psycopg://agent_runtime:local_agent_password@127.0.0.1:5433/agent_runtime

# Keep sync during rollout. Change to background only after the worker is deployed.
AGENT_EXECUTION_MODE=sync
AGENT_LEASE_SECONDS=120
AGENT_HEARTBEAT_SECONDS=30
AGENT_MAX_CLAIMS=3
AGENT_POLL_INTERVAL_SECONDS=1
AGENT_CHECKPOINT_RETENTION_DAYS=30
AGENT_METADATA_RETENTION_DAYS=180

# Local services
JAVA_SERVER_PORT=8085
PYTHON_SERVER_PORT=8005
PYTHON_SERVICE_URL=http://localhost:8005

# Shopify Dev Dashboard app. Never commit real values.
SHOPIFY_ENABLED=false
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# App scopes required by the listing workflow:
# write_products, read_locations, read_publications, write_publications, write_inventory

# CJ product source. Keep disabled to use deterministic local Fake data.
CJ_ENABLED=false
CJ_API_KEY=

# Copy/SEO model. Keep disabled to use the deterministic Fake agent.
LLM_ENABLED=false
# ApiNebula is the default OpenAI-compatible model provider.
# Keep real values in the ignored .env only.
LLM_API_KEY=
LLM_BASE_URL=https://apinebula.ai/v1
LLM_MODEL=gpt-6-sol
# Maximum compliance-driven revisions after the initial generation (0-3).
COPY_SEO_MAX_REVISIONS=1
# Maximum business tool calls in one Agent run (1-10).
COPY_SEO_MAX_TOOL_CALLS=4
